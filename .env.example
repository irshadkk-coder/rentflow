# Database configuration (PostgreSQL 14+)
# Provide DATABASE_URL or the standard PG connection variables:
DATABASE_URL="postgresql://postgres:your_db_password_here@localhost:5432/rentflow"
PGHOST="127.0.0.1"
PGPORT="5432"
PGUSER="postgres"
PGPASSWORD="your_db_password_here"
PGDATABASE="rentflow"

# Application Security & Server
JWT_SECRET="your-jwt-secret-key-at-least-32-chars"
DJANGO_SECRET_KEY="your-django-secret-key-here"
PORT=3000
VITE_API_URL="http://127.0.0.1:8000"
NODE_ENV="development"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Bot Protection (Cloudflare Turnstile - Optional in Dev, Required in Prod)
TURNSTILE_SITE_KEY="your_turnstile_site_key_here"
TURNSTILE_SECRET_KEY="your_turnstile_secret_key_here"
VITE_TURNSTILE_SITE_KEY="your_turnstile_site_key_here"

# Brevo Transactional Email Configuration (Official API v3)
EMAIL_PROVIDER="brevo"
BREVO_API_KEY="xkeysib-your-brevo-api-key-here"
DEFAULT_FROM_EMAIL="RentFlow <no-reply@yourverifieddomain.com>"
FRONTEND_URL="http://localhost:3000"
BREVO_TIMEOUT="10"

# Fallback / Standard Django Email Configuration (Optional)
EMAIL_BACKEND="django.core.mail.backends.console.EmailBackend"
EMAIL_HOST="smtp.example.com"
EMAIL_PORT="587"
EMAIL_USE_TLS="True"
EMAIL_HOST_USER="user@example.com"
EMAIL_HOST_PASSWORD="your_email_password_here"

# ==============================================================================
# RentFlow Production Environment Configuration Template
# COPY this file to .env.production on your production server.
# NEVER commit real production secrets into version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Django Security Settings
# ------------------------------------------------------------------------------
# Must ALWAYS be False in production to disable debug tracebacks and sensitive endpoints.
DJANGO_DEBUG=False

# Cryptographically strong random key (at least 50 characters).
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-very-long-cryptographically-random-secret-key-50-chars

# Cryptographically strong random secret (at least 32 characters) for signing JWT access tokens.
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-secure-32-byte-hex-jwt-signing-secret-key-2026

# Comma-separated list of fully qualified hostnames/domains permitted to reach Django.
# Example: app.rentflow.com,api.rentflow.com
ALLOWED_HOSTS=app.rentflow.com,api.rentflow.com

# Comma-separated list of allowed frontend origins for Cross-Origin Resource Sharing (CORS).
# Example: https://app.rentflow.com
CORS_ALLOWED_ORIGINS=https://app.rentflow.com

# Comma-separated list of origins trusted for Cross-Site Request Forgery (CSRF) validation.
# Example: https://app.rentflow.com
CSRF_TRUSTED_ORIGINS=https://app.rentflow.com

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL 14+)
# ------------------------------------------------------------------------------
# Full PostgreSQL connection URL:
DATABASE_URL=postgresql://rentflow_user:replace_with_strong_password@db:5432/rentflow

# Individual connection parameters (used by compose and backup scripts):
PGHOST=db
PGPORT=5432
PGUSER=rentflow_user
PGPASSWORD=replace_with_strong_password
PGDATABASE=rentflow

# ------------------------------------------------------------------------------
# 3. Redis & Celery Background Queue
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 4. HTTPS & Cookie Security (Enable when TLS is terminated at Nginx/Load Balancer)
# ------------------------------------------------------------------------------
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000

# ------------------------------------------------------------------------------
# 5. Gunicorn Server Tuning
# ------------------------------------------------------------------------------
# Recommended workers: (2 * CPU cores) + 1
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 6. Public Ingress Port
# ------------------------------------------------------------------------------
PORT=80

# ------------------------------------------------------------------------------
# 7. Brevo Transactional Email Configuration (Production)
# ------------------------------------------------------------------------------
# Provider must be set to 'brevo'
EMAIL_PROVIDER=brevo

# Official Brevo API Key (generated in Brevo dashboard: SMTP & API > API Keys)
# Keep strictly secret. Never commit to source code.
BREVO_API_KEY=xkeysib-replace-with-your-production-brevo-api-key

# Verified Sender Email in Brevo (Must match your authenticated domain)
DEFAULT_FROM_EMAIL=RentFlow <no-reply@yourverifieddomain.com>

# Production Frontend Base URL (MUST use HTTPS and MUST NOT be localhost)
FRONTEND_URL=https://app.rentflow.com

# HTTP request timeout in seconds when communicating with Brevo API
BREVO_TIMEOUT=10

# ------------------------------------------------------------------------------
# 8. Initial Production Owner Bootstrap (Used once by `python manage.py init_production`)
# ------------------------------------------------------------------------------
# The verified administrative owner account created on first deployment.
# Passwords must be at least 8 chars and must NEVER be the demo 'Password123!'.
PROD_OWNER_EMAIL=owner@yourdomain.com
PROD_OWNER_PASSWORD=replace-with-a-very-strong-unique-owner-password-2026!
PROD_OWNER_NAME="Organization Owner"
